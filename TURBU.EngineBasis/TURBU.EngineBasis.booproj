<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <RootNamespace>TURBU.EngineBasis</RootNamespace>
    <AssemblyName>TURBU.EngineBasis</AssemblyName>
    <Ducky>False</Ducky>
    <Strict>False</Strict>
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Boo.Lang.Compiler">
      <HintPath>$(BooBinPath)/Boo.Lang.Compiler.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Not part of this repository; the path below is where the old project looked for it. -->
    <Reference Include="Boo.Adt">
      <HintPath>../../boo-extensions/build/Boo.Adt.dll</HintPath>
    </Reference>
    <Reference Include="Boo.Lang.Useful">
      <HintPath>$(BooBinPath)/Boo.Lang.Useful.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Not part of this repository; the path below is where the old project looked for it. -->
    <Reference Include="SDL2-CS">
      <HintPath>../../SDL2-CS/bin/Debug/SDL2-CS.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pythia.Runtime/Pythia.Runtime.booproj" />
    <ProjectReference Include="../TURBU.Meta/TURBU.Meta.booproj" />
    <ProjectReference Include="../TURBU.SDLFrame/TURBU.SDLFrame/TURBU.SDL.booproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="sdlstreams.boo" />
  </ItemGroup>

  <Import Project="$(BooBinPath)/Boo.Microsoft.Build.targets" />

  <ItemGroup>
    <Compile Remove="archiveInterface.Meta.boo" />
    <Compile Remove="dm.shaders.Meta.boo" />
    <Compile Remove="engine.manager.Meta.boo" />
    <Compile Remove="engine_manager.boo" />
    <Compile Remove="sdl.canvas.Meta.boo" />
    <Compile Remove="SDL.ImageManager.Meta.boo" />
    <Compile Remove="sdl_canvas.boo" />
    <Compile Remove="sdl_frame.boo" />
    <Compile Remove="SDL_ImageManager.boo" />
    <Compile Remove="SDL_rwStream.boo" />
    <Compile Remove="SG_defs.boo" />
    <Compile Remove="StringListComp.boo" />
    <Compile Remove="turbu.engines.Meta.boo" />
    <Compile Remove="turbu.multimaps.Meta.boo" />
  </ItemGroup>

</Project>