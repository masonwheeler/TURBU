<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <RootNamespace>LCF_Parser</RootNamespace>
    <AssemblyName>LCF Parser</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Ducky>False</Ducky>
    <Strict>False</Strict>
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Used at run time too (the converter builds Boo ASTs), so it must be in the deps.json for the runtime to find it. -->
    <Reference Include="Boo.Lang.Compiler">
      <HintPath>$(BooBinPath)/Boo.Lang.Compiler.dll</HintPath>
    </Reference>
    <!-- The compile of the converted project runs in this process, and the macros and the pipeline it uses need these. -->
    <Reference Include="Boo.Lang.Useful">
      <HintPath>$(BooBinPath)/Boo.Lang.Useful.dll</HintPath>
    </Reference>
    <Reference Include="Boo.Lang.Extensions">
      <HintPath>$(BooBinPath)/Boo.Lang.Extensions.dll</HintPath>
    </Reference>
    <Reference Include="Boo.Lang.Interpreter">
      <HintPath>$(BooBinPath)/Boo.Lang.Interpreter.dll</HintPath>
    </Reference>
    <Reference Include="Boo.Lang.PatternMatching">
      <HintPath>$(BooBinPath)/Boo.Lang.PatternMatching.dll</HintPath>
    </Reference>
    <!-- Not part of this repository; the path below is where the old project looked for it. -->
    <Reference Include="Boo.Adt">
      <HintPath>../../boo-extensions/build/Boo.Adt.dll</HintPath>
    </Reference>
    <!-- Not part of this repository; the path below is where the old project looked for it. -->
    <Reference Include="SDL2-CS">
      <HintPath>../../SDL2-CS/bin/Debug/SDL2-CS.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pythia.Runtime/Pythia.Runtime.booproj" />
    <ProjectReference Include="../TURBU.Design.Optimizations/TURBU.Design.Optimizations.booproj" />
    <ProjectReference Include="../TURBU.EngineBasis/TURBU.EngineBasis.booproj" />
    <ProjectReference Include="../TURBU.Meta/TURBU.Meta.booproj" />
    <ProjectReference Include="../TURBU.RM2K.Import/TURBU.RM2K.Import.booproj" />
    <ProjectReference Include="../TURBU.RM2K.MapEngine/TURBU.RM2K.MapEngine.booproj" />
    <ProjectReference Include="../TURBU.RM2K.TextDataReader/TURBU.RM2K.TextDataReader.booproj" />
    <ProjectReference Include="../TURBU.RM2K/TURBU.RM2K.booproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
    <!-- The native libraries SDL2-CS loads. This is a 64 bit process, so they are the 64 bit builds, in dlls/x64. -->
    <None Include="../dlls/x64/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="$(BooBinPath)/Boo.Microsoft.Build.targets" />

</Project>