<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <RootNamespace>TURBU.SDL</RootNamespace>
    <AssemblyName>TURBU.SDL</AssemblyName>
    <Ducky>False</Ducky>
    <Strict>False</Strict>
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Not part of this repository; the path below is where the old project looked for it. -->
    <Reference Include="Boo.Adt">
      <HintPath>..\..\..\boo-extensions\build\Boo.Adt.dll</HintPath>
    </Reference>
    <Reference Include="Boo.Lang.Useful">
      <HintPath>$(BooBinPath)/Boo.Lang.Useful.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Not part of this repository; the path below is where the old project looked for it. -->
    <Reference Include="SDL2-CS">
      <HintPath>../../../SDL2-CS/bin/Debug/SDL2-CS.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Pythia.Runtime/Pythia.Runtime.booproj" />
  </ItemGroup>

  <Import Project="$(BooBinPath)/Boo.Microsoft.Build.targets" />

</Project>